<!DOCTYPE html>
<html lang="en">
<head>
<%- include('/partials/head') %>
</head>
<body>

<%- include('/partials/header') %>

<section class="page-hero gallery">
  <div class="copy">
    <h1>Moments, <em>quiet</em>.</h1>
    <div class="jp-line">写真ギャラリー　—　GALLERY</div>
  </div>
</section>

<section class="gallery">
  <div class="wrap">
    <div class="masonry" id="grid"></div>
  </div>
</section>

<div class="lb" id="lb">
  <div class="close">✕&nbsp; Close</div>
  <div class="big" id="big"></div>
</div>

<%- include('/partials/footer') %>

<script>
const g = '<%= rootPath %>img/gallery/';

const items = [
  {cat:'ceremonies', title:'Gokitō',               ratio:1, img:g+'gokito.jpg'},
  {cat:'grounds',    title:'Front Garden', ratio:3, img:g+'front-garden.jpg'},
  {cat:'details',    title:'Inner Courtyard Above', ratio:4, img:g+'inner-courtyard-above.jpg'},
  {cat:'grounds',    title:'Stone Stairway',        ratio:5, img:g+'stone-stairway.jpg'},
  {cat:'ceremonies', title:'Hanamatsuri',           ratio:1, img:g+'hanamatsuri.jpg'},
  {cat:'details',    title:'Lantern',               ratio:2, img:g+'lantern.jpg'},
  {cat:'ceremonies', title:'Water Purification', ratio:6, img:g+'water-purification.jpg'},
  {cat:'grounds',    title:'Five-Story Gate',       ratio:4, img:g+'five-story-gate.jpg'},
  {cat:'seasons',    title:'Shishi-odoshi',         ratio:1, img:g+'shishi-odoshi.jpg'},
  {cat:'details',    title:'Taiko Drum II',         ratio:3, img:g+'taiko-drum-2.jpg'},
  {cat:'grounds',    title:'Buddhist Practice Hall', ratio:2, img:g+'buddhist-practice-hall.jpg'},
  {cat:'seasons',    title:'Shishi-odoshi in Snow', ratio:4, img:g+'shishi-odoshi-in-snow.jpg'},
  {cat:'details',    title:'Prayer Hall Door',      ratio:6, img:g+'prayer-hall-door.jpg'},
  {cat:'grounds',    title:'Temple Office Sign',    ratio:1, img:g+'temple-office-sign.jpg'},
  {cat:'ceremonies', title:'Setsubun',              ratio:3, img:g+'setsubun.jpg'},
  {cat:'details',    title:'Taiko Drum',            ratio:4, img:g+'taiko-drum.jpg'},
  {cat:'ceremonies', title:'Gokitō II',             ratio:5, img:g+'gokito-2.jpg'},
  {cat:'grounds',    title:'Temple Name Monument', ratio:1, img:g+'temple-name-monument.jpg'},
  {cat:'details',    title:'Omikuji',               ratio:2, img:g+'omikuji.jpg'},
  {cat:'grounds',    title:'Buddhist Ritual Bell', ratio:4, img:g+'buddhist-ritual-bell.jpg'},
  {cat:'ceremonies', title:'Brass Band',            ratio:6, img:g+'brass-band.jpg'},
  {cat:'seasons',    title:"New Year's Sunrise", ratio:1, img:g+'new-years-sunrise.jpg'},
  {cat:'grounds',    title:'Grave Hall',            ratio:2, img:g+'grave-hall.jpg'},
  {cat:'ceremonies', title:'Water Purification Place', ratio:5, img:g+'water-purification-place.jpg'},
  {cat:'seasons',    title:'New Year Dawn',         ratio:4, img:g+'new-year-dawn.jpg'},
  {cat:'grounds',    title:'Inner Courtyard',       ratio:3, img:g+'inner-courtyard.jpg'},
  {cat:'ceremonies', title:'Ordination',            ratio:2, img:g+'ordination.jpg'},
  {cat:'ceremonies', title:'Brass Band II',         ratio:4, img:g+'brass-band-2.jpg'},
];

function shuffle(a){ const r = [...a]; for(let i=r.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[r[i],r[j]]=[r[j],r[i]];} return r; }
const shuffled = shuffle(items);

const grid = document.getElementById('grid');
const lb = document.getElementById('lb');
const big = document.getElementById('big');

function render(cat){
  grid.innerHTML = '';
  let n = 0;
  shuffled.forEach(it=>{
    if(cat !== 'all' && it.cat !== cat) return;
    n++;
    const el = document.createElement('div');
    el.className = `tile r${it.ratio}`;
    const bg = it.img ? `background-image:url('${it.img}')` : '';
    el.innerHTML = `
      <div class="img ${it.ph ? 'ph-'+it.ph : ''}" style="${bg}"></div>
      <div class="overlay"><div class="cap"><b>${it.title}</b></div></div>
    `;
    if(it.img){
      el.addEventListener('click', ()=>{
        big.style.backgroundImage = `url('${it.img}')`;
        lb.classList.add('on');
      });
    }
    grid.appendChild(el);
  });
}
render('all');

lb.onclick = ()=> lb.classList.remove('on');
document.addEventListener('keydown', e=>{ if(e.key==='Escape') lb.classList.remove('on'); });
</script>
<script src="<%= rootPath %>site.js?v=<%= assetVersion %>"></script>
</body>
</html>

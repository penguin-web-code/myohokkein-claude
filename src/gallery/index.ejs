<!DOCTYPE html>
<html lang="en">
<head>
<%- include('/partials/head') %>
</head>
<body>

<%- include('/partials/header') %>

<section class="page-hero gallery">
  <div class="copy">
    <h1>Moments, <em>quiet</em>.</h1>
    <div class="jp-line">写真ギャラリー　—　GALLERY</div>
  </div>
</section>

<section class="gallery">
  <div class="wrap">
    <div class="masonry" id="grid"></div>
  </div>
</section>

<div class="lb" id="lb">
  <div class="close">✕&nbsp; Close</div>
  <div class="big" id="big"></div>
</div>

<%- include('/partials/footer') %>

<script>
const g = '<%= rootPath %>img/gallery/';

const items = [
  {cat:'ceremonies', title:'Gokitō',               ratio:1, img:g+'御祈祷1.JPG'},
  {cat:'grounds',    title:'Mountain Gate',         ratio:3, img:g+'春の正門.JPG'},
  {cat:'details',    title:'Inner Courtyard Above', ratio:4, img:g+'中庭上から.jpg'},
  {cat:'grounds',    title:'Stone Stairway',        ratio:5, img:g+'階段.jpg'},
  {cat:'ceremonies', title:'Hanamatsuri',           ratio:1, img:g+'花まつり白象.JPG'},
  {cat:'details',    title:'Lantern',               ratio:2, img:g+'提灯.jpg'},
  {cat:'ceremonies', title:'Suigyō Practice',       ratio:6, img:g+'水行.JPG'},
  {cat:'grounds',    title:'Five-Story Gate',       ratio:4, img:g+'五重の門.jpg'},
  {cat:'seasons',    title:'Shishi-odoshi',         ratio:1, img:g+'鹿威し.jpg'},
  {cat:'details',    title:'Taiko Drum II',         ratio:3, img:g+'太鼓 (2).JPG'},
  {cat:'ceremonies', title:'Segaki',                ratio:5, img:g+'せがき.JPG'},
  {cat:'grounds',    title:'Training Hall',         ratio:2, img:g+'道場斜め.jpg'},
  {cat:'seasons',    title:'Shishi-odoshi in Snow', ratio:4, img:g+'鹿威し雪.jpg'},
  {cat:'details',    title:'Prayer Hall Door',      ratio:6, img:g+'祈祷所扉横.jpg'},
  {cat:'grounds',    title:'Temple Office Sign',    ratio:1, img:g+'寺務所看板.jpg'},
  {cat:'ceremonies', title:'Setsubun',              ratio:3, img:g+'豆まき.JPG'},
  {cat:'details',    title:'Taiko Drum',            ratio:4, img:g+'太鼓.jpg'},
  {cat:'ceremonies', title:'Gokitō II',             ratio:5, img:g+'御祈祷2.JPG'},
  {cat:'grounds',    title:'Peace Stone',           ratio:1, img:g+'看板石.jpg'},
  {cat:'details',    title:'Omikuji',               ratio:2, img:g+'御籤.jpg'},
  {cat:'grounds',    title:'Dome, at Dusk',         ratio:4, img:g+'金丸.JPG'},
  {cat:'ceremonies', title:'Brass Band',            ratio:6, img:g+'吹奏楽1.JPG'},
  {cat:'seasons',    title:'First Light',           ratio:1, img:g+'初日の出.jpg'},
  {cat:'grounds',    title:'Ossuary Altar',         ratio:2, img:g+'納骨堂ご本尊.jpg'},
  {cat:'ceremonies', title:'Suigyō — Gate',         ratio:5, img:g+'水行肝門.jpg'},
  {cat:'seasons',    title:'New Year Dawn',         ratio:4, img:g+'初日の出　トリ.JPG'},
  {cat:'details',    title:'Sotoba',                ratio:1, img:g+'塔婆.jpg'},
  {cat:'grounds',    title:'Inner Courtyard',       ratio:3, img:g+'中庭.jpg'},
  {cat:'ceremonies', title:'Ordination',            ratio:2, img:g+'得度式.JPG'},
  {cat:'ceremonies', title:'Brass Band II',         ratio:4, img:g+'吹奏楽2.JPG'},
];

function shuffle(a){ const r = [...a]; for(let i=r.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[r[i],r[j]]=[r[j],r[i]];} return r; }
const shuffled = shuffle(items);

const grid = document.getElementById('grid');
const lb = document.getElementById('lb');
const big = document.getElementById('big');

function render(cat){
  grid.innerHTML = '';
  let n = 0;
  shuffled.forEach(it=>{
    if(cat !== 'all' && it.cat !== cat) return;
    n++;
    const el = document.createElement('div');
    el.className = `tile r${it.ratio}`;
    const bg = it.img ? `background-image:url('${it.img}')` : '';
    el.innerHTML = `
      <div class="img ${it.ph ? 'ph-'+it.ph : ''}" style="${bg}"></div>
      <div class="overlay"><div class="cap"><b>${it.title}</b></div></div>
    `;
    if(it.img){
      el.addEventListener('click', ()=>{
        big.style.backgroundImage = `url('${it.img}')`;
        lb.classList.add('on');
      });
    }
    grid.appendChild(el);
  });
  document.getElementById('cnt').textContent = String(n).padStart(2,'0');
}
render('all');

lb.onclick = ()=> lb.classList.remove('on');
document.addEventListener('keydown', e=>{ if(e.key==='Escape') lb.classList.remove('on'); });
</script>
<script src="<%= rootPath %>site.js"></script>
</body>
</html>
